{
  "name": "Shopa",
  "short_name": "Shopa",
  "description": "Create a simple store page for your Instagram & WhatsApp business.",
  "id": "/",
  "scope": "/",
  "start_url": "/?utm_source=homescreen",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "categories": ["business", "shopping", "productivity"],
  "background_color": "#faf9f7",
  "theme_color": "#ed7712",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
